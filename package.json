{
	"name": "obj-codec",
	"version": "2.0.0",
	"description": "A binary codec for JavaScript values: reference fidelity, near-complete type coverage, and chunkable streaming",
	"keywords": [
		"serialization",
		"binary-encoding",
		"stream"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JonnyJong/obj-codec.git"
	},
	"author": "jonnyjonny",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/JonnyJong/obj-codec/issues"
	},
	"homepage": "https://github.com/JonnyJong/obj-codec#readme",
	"main": "dist/index.js",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"browser": "dist/web.esm.js",
	"exports": {
		".": {
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.esm.js",
			"node": "./dist/index.js",
			"require": "./dist/index.js"
		},
		"./web": {
			"default": "./dist/web.js",
			"types": "./dist/web.d.ts",
			"import": "./dist/web.esm.js",
			"require": "./dist/web.js"
		}
	},
	"files": [
		"dist/",
		"docs/"
	],
	"scripts": {
		"test": "vitest",
		"test:ci": "vitest run",
		"check": "tsc --noEmit",
		"clean": "node clean.js",
		"compile": "pnpm clean && rolldown -c && tsc",
		"prepublish": "pnpm compile"
	},
	"packageManager": "pnpm@12.16.1",
	"devDependencies": {
		"@types/node": "^22.15.29",
		"@vitest/coverage-v8": "^5.0.5",
		"rolldown": "^1.2.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22"
	},
	"volta": {
		"node": "24.22.2"
	}
}